<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".MyPrintApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyPrint">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyPrint"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Maketni boshqa ilovalarga (Telegram, pochta) yuborish
            uchun kerak. Android 7 dan boshlab file:// havolalarni
            ilovalar orasida uzatish taqiqlangan — fayl content://
            havolasi orqali, vaqtinchalik ruxsat bilan beriladi.

            authorities qiymati DesignShare.kt dagi
            "${applicationId}.fileprovider" bilan aynan mos
            kelishi shart, aks holda ulashishda ilova qulaydi.

            exported="false" — provayderni faqat biz beradigan
            aniq ruxsat orqali ishlatish mumkin, boshqa ilova
            o'zicha kira olmaydi.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>